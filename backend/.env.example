# Copy this file to backend/.env and fill in the real key.
# backend/.env is gitignored — never commit real keys.
ANTHROPIC_API_KEY=
# Only needed if the key above is org-level (not workspace-scoped).
ANTHROPIC_WORKSPACE_ID=

# MongoDB Atlas connection string. Keep credentials only in backend/.env.
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/?retryWrites=true&w=majority
# The database is created on first write; defaults to localconnect.
MONGODB_DB_NAME=localconnect
