# Development proxy: /api/plan -> http://localhost:3001/plan
API_PROXY_TARGET=http://localhost:3001

# Public backend base URL. Use /api with the development proxy.
# For production, supply the backend URL or configure a same-origin /api proxy.
# Never put secret API keys in VITE_ variables; they are exposed to the browser.
VITE_API_BASE_URL=/api
